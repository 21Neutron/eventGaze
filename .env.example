# ========================================================
# EventGaze Environment Variables Template
# Copy this file to .env before starting docker-compose
# ========================================================

# --------------------------------------------------------
# 1. Database Configuration
# (Leave default for local Docker PostgreSQL, or set your AWS RDS endpoint)
# --------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://<your-rds-endpoint>.rds.amazonaws.com:5432/eventgaze
# SPRING_DATASOURCE_USERNAME=your_db_username
# SPRING_DATASOURCE_PASSWORD=your_db_password

# --------------------------------------------------------
# 2. JWT Security Key (minimum 32 characters / 256 bits)
# --------------------------------------------------------
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_at_least_32_chars_long

# --------------------------------------------------------
# 3. AWS S3 Storage Configuration
# --------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-eventgaze-bucket-name
STORAGE_BASE_URL=https://your-eventgaze-bucket-name.s3.amazonaws.com/
